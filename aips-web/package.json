{
  "name": "aips-web",
  "description": "Frontend for AIPS (AI ID Photo Studio).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "prebuild": "node scripts/ensure-env.mjs",
    "dev": "vite",
