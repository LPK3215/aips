    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4"
  }
